{
  "name": "veydrift-operator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --no-env-file build ./apps/operator/src/index.ts --outdir ./dist/operator --target bun",
    "check": "bun --no-env-file run format:check && bun --no-env-file run lint && bun --no-env-file run typecheck && bun --no-env-file run test && bun --no-env-file run build",
    "dev": "bun --watch ./apps/operator/src/index.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "start": "bun ./apps/operator/src/index.ts",
    "test": "bun --no-env-file test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
