# Replace this synthetic public address only in the ignored .env.
# The read-only snapshot runtime does not require or read a private key.
VEYDRIFT_PLAYER_ADDRESS=0x1111111111111111111111111111111111111111
# Optional. Defaults to 60 seconds; accepted range is 30 through 86400.
VEYDRIFT_SNAPSHOT_INTERVAL_SECONDS=60
# Optional. Defaults to 3000; the server always binds to 127.0.0.1.
VEYDRIFT_OPERATOR_PORT=3000
